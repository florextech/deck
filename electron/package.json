{
  "name": "deck",
  "version": "0.2.0",
  "description": "Stream Deck for your tablet",
  "author": "Florex Labs",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/florextech/deck.git"
  },
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.deck.app",
    "productName": "Deck",
    "publish": null,
    "files": [
      "main.js",
      "agent.js",
      "server.js",
      "public/**/*",
      "deck.config.json"
    ],
    "extraResources": [
      {
        "from": "deck.config.json",
        "to": "deck.config.json"
      }
    ],
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false
    }
  },
  "dependencies": {
    "cors": "2.8.5",
    "express": "4.21.2",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "0.12.0",
    "socket.io": "4.8.1",
    "socket.io-client": "4.8.1"
  },
  "devDependencies": {
    "electron": "33.4.0",
    "electron-builder": "25.1.8"
  }
}
